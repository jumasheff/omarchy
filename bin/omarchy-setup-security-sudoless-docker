#!/bin/bash

# omarchy:summary=Enable sudoless Docker by adding your user to the docker group (root-equivalent!)
# omarchy:requires-sudo=true

set -e

# Ask about the configured groups, not this session's: once enabled it stays
# enabled for the account even before the reboot that lets this session use it.
if ! omarchy-sudo-docker --configured; then
  omarchy-i18n docker.alreadyEnabled "$USER"
  echo ""
  omarchy-i18n docker.disableCommand omarchy-remove-security-sudoless-docker
  echo ""
  exit 0
fi

echo ""
omarchy-i18n docker.warning
printf '\n\n'
omarchy-i18n docker.rootAccess
printf '\n\n'
printf '    docker run -v /:/host alpine   # %s\n' "$(omarchy-i18n docker.hostAccess)"
echo ""
omarchy-i18n docker.risk
printf '\n\n'

if gum confirm --no-show-help --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$(omarchy-i18n docker.enableSudoless)"; then
  sudo usermod -aG docker "$USER"
  # A new docker group membership is only picked up by a fresh session, and in
  # practice logging out or newgrp isn't enough — only a reboot reliably applies
  # it. Record it so a later `omarchy update` still prompts
  # (omarchy-update-restart reads this), then offer to do it now.
  omarchy-state set reboot-required
  echo ""
  omarchy-i18n docker.enabled
  echo ""
  omarchy-i18n docker.disableMenu
  printf '\n\n'
  # The migration reuses this command during 'omarchy update' and defers the
  # reboot to omarchy-update-restart, so it doesn't cut the update short.
  if [[ -z ${OMARCHY_DEFER_REBOOT:-} ]] && gum confirm --no-show-help --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$(omarchy-i18n docker.rebootToApply)"; then
    omarchy-system reboot
  fi
else
  omarchy-i18n docker.aborted
  echo ""
fi
